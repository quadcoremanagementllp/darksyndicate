# Set these in Hostinger's Environment Variables panel. Never commit real values.
DATABASE_URL="mysql://USER:URL_ENCODED_PASSWORD@localhost:3306/DATABASE_NAME"
DB_POOL_LIMIT="3"
DB_SSL="false"
JWT_SECRET="generate-a-random-secret-at-least-64-characters-long"
NEXT_PUBLIC_APP_URL="https://your-domain.example"
APP_URL="https://your-domain.example"

# Online booking checkout remains disabled until all three values are set.
PAYMENT_MODE="disabled"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional transactional email. Password reset requires these values.
RESEND_API_KEY=""
EMAIL_FROM="Dark Syndicate <mail@your-domain.example>"
CONTACT_EMAIL=""

# Empty-database bootstrap only; remove these values after running it.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
